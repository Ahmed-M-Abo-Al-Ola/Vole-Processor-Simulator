; ======================================================================
; or_0a_0f.vol  -  Bitwise OR
; Purpose: OR 0A with 0F and show the result.
; Expected screen output: 0F
; ======================================================================
200A    ; R0 = 0A
210F    ; R1 = 0F
7201    ; R2 = R0 OR R1 = 0F
32FF    ; screen <- R2
C000    ; halt
